{
  "name": "@kujolang/kujo-opencode",
  "version": "0.2.0",
  "description": "Local Kujo Ability and skills integration for OpenCode 2.",
  "type": "module",
  "bin": {
    "kujo-opencode": "bin/kujo-opencode.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "catalog/",
    "assets/",
    ".generated/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/PROVENANCE.md",
    "scripts/build-release.mjs",
    "scripts/check-opencode-host.mjs",
    "docs/VERIFICATION.md"
  ],
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test tests/catalog.test.mjs tests/executor.test.mjs tests/runtime.test.mjs tests/security.test.mjs tests/setup.test.mjs tests/release.test.mjs tests/opencode.test.mjs tests/recovery.test.mjs tests/plugin.test.mjs tests/tui.test.mjs tests/source-tools.test.mjs tests/project-activation.test.mjs tests/specialists.test.mjs tests/evidence.test.mjs tests/project-state.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "test:opencode": "node scripts/check-opencode-host.mjs",
    "test:fresh": "node tests/fresh-install.mjs",
    "test:native": "node tests/native-host.mjs"
  },
  "dependencies": {
    "@kujolang/kujo-runtime": "1.8.0",
    "jsonc-parser": "3.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kujolang/kujo-opencode.git"
  },
  "homepage": "https://github.com/kujolang/kujo-opencode#readme",
  "bugs": {
    "url": "https://github.com/kujolang/kujo-opencode/issues"
  },
  "keywords": [
    "kujo",
    "opencode",
    "mcp",
    "agent-skills",
    "ability"
  ],
  "devDependencies": {
    "@opencode/plugin": "2.0.31"
  },
  "exports": {
    ".": "./lib/plugin.mjs",
    "./tui": "./lib/tui.mjs"
  }
}
