[
  {
    "definition": {
      "schema": "kujo.ability/v1",
      "id": "kujo.opencode.source.inspect",
      "version": "1.0.0",
      "title": "Check and lint Kujo source",
      "description": "Check and lint Kujo source using the canonical installed runtime on a private copy, without executing the program or modifying source. Single UTF-8 .kujo file, at most 64 KiB.",
      "input_schema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "file"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "effects": [
        {
          "kind": "read",
          "resource": "kujo.source.file"
        }
      ],
      "idempotency": {
        "mode": "intrinsic"
      }
    },
    "tool": {
      "name": "kujo_source_inspect",
      "description": "Check and lint Kujo source. Returns source digest and canonical diagnostics; does not execute code or apply changes."
    },
    "adapter": "source_inspect"
  },
  {
    "definition": {
      "schema": "kujo.ability/v1",
      "id": "kujo.opencode.source.format",
      "version": "1.0.0",
      "title": "Preview Kujo formatting",
      "description": "Preview Kujo formatting using the canonical installed runtime on a private copy, without executing the program or modifying source. Single UTF-8 .kujo file, at most 64 KiB.",
      "input_schema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "file"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "effects": [
        {
          "kind": "read",
          "resource": "kujo.source.file"
        }
      ],
      "idempotency": {
        "mode": "intrinsic"
      }
    },
    "tool": {
      "name": "kujo_source_format",
      "description": "Preview Kujo formatting. Returns source digest and canonical diagnostics; does not execute code or apply changes."
    },
    "adapter": "source_format"
  },
  {
    "definition": {
      "schema": "kujo.ability/v1",
      "id": "kujo.opencode.source.preview",
      "version": "1.0.0",
      "title": "Preview source execution",
      "description": "Preview a canonical Kujo run/test command and an explicit multi-file snapshot with digests. Include imports, resources and test expected outputs; no program execution.",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "run",
              "test"
            ]
          },
          "entry": {
            "type": "string",
            "maxLength": 1024
          },
          "args": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        "required": [
          "mode",
          "files"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "effects": [
        {
          "kind": "read",
          "resource": "kujo.source.snapshot"
        }
      ],
      "idempotency": {
        "mode": "intrinsic"
      }
    },
    "tool": {
      "name": "kujo_source_preview",
      "description": "Preview a canonical Kujo run/test command and an explicit multi-file snapshot with digests. Include imports, resources and test expected outputs; no program execution."
    },
    "adapter": "source_preview"
  },
  {
    "definition": {
      "schema": "kujo.ability/v1",
      "id": "kujo.opencode.source.execute",
      "version": "1.0.0",
      "title": "Run reviewed Kujo source or tests",
      "description": "Execute the exact digest-bound source snapshot after human approval. Canonical Kujo run or test, 120-second window, retained output directory. Trusted code may perform host filesystem, process and network effects; this is not an OS sandbox.",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "run",
              "test"
            ]
          },
          "entry": {
            "type": "string",
            "maxLength": 1024
          },
          "args": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "runtime_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "mode",
          "files",
          "runtime_sha256"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "effects": [
        {
          "kind": "external",
          "resource": "kujo.source.host-effects"
        },
        {
          "kind": "write",
          "resource": "kujo.source.execution-snapshot"
        }
      ],
      "idempotency": {
        "mode": "keyed"
      }
    },
    "tool": {
      "name": "kujo_source_execute",
      "description": "Execute the exact digest-bound source snapshot after human approval. Canonical Kujo run or test, 120-second window, retained output directory. Trusted code may perform host filesystem, process and network effects; this is not an OS sandbox."
    },
    "adapter": "source_execute"
  }
]
