[
  {
    "definition": {
      "schema": "kujo.ability/v1",
      "id": "kujo.opencode.knowledge.preview",
      "version": "1.0.0",
      "title": "Preview offline knowledge",
      "description": "Review the local Markdown/text/Kujo corpus and exact digest before indexing. Hidden files, node_modules, dist and vendor are excluded. At most 128 files and 8 MiB.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "default": "default"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "default": "docs"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "effects": [
        {
          "kind": "read",
          "resource": "kujo.opencode.knowledge"
        }
      ],
      "idempotency": {
        "mode": "intrinsic"
      }
    },
    "tool": {
      "name": "kujo_knowledge_preview",
      "description": "Review the local Markdown/text/Kujo corpus and exact digest before indexing. Hidden files, node_modules, dist and vendor are excluded. At most 128 files and 8 MiB."
    },
    "adapter": "knowledge_preview",
    "source": "rag"
  },
  {
    "definition": {
      "schema": "kujo.ability/v1",
      "id": "kujo.opencode.knowledge.index",
      "version": "1.0.0",
      "title": "Build reviewed offline knowledge",
      "description": "Build the exact reviewed corpus through canonical RAG with local hash embeddings. Replace the managed index transactionally after one-time approval.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "default": "default"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "default": "docs"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "digest"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "effects": [
        {
          "kind": "write",
          "resource": "kujo.opencode.knowledge"
        }
      ],
      "idempotency": {
        "mode": "keyed"
      }
    },
    "tool": {
      "name": "kujo_knowledge_index",
      "description": "Build the exact reviewed corpus through canonical RAG with local hash embeddings. Replace the managed index transactionally after one-time approval."
    },
    "adapter": "knowledge_index",
    "source": "rag"
  },
  {
    "definition": {
      "schema": "kujo.ability/v1",
      "id": "kujo.opencode.knowledge.status",
