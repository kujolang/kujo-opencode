          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "effects": [
        {
          "kind": "read",
          "resource": "kujo.opencode.knowledge"
        }
      ],
      "idempotency": {
        "mode": "intrinsic"
      }
    },
    "tool": {
      "name": "kujo_knowledge_status",
      "description": "Compare the managed corpus digest with current files and runtime provenance. Does not query or rebuild."
