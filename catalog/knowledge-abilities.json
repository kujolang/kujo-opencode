        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "default": "default"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "question"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "effects": [
        {
          "kind": "read",
          "resource": "kujo.opencode.knowledge"
        }
      ],
      "idempotency": {
        "mode": "intrinsic"
      }
    },
    "tool": {
      "name": "kujo_knowledge_query",
